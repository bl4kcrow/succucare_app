rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    //All under users/{uid}/...
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      //Subcollecions (plants, etc.)
      match /{document=**}{
        allow read, write: if isOwner(uid);
      }
    }
  }
}